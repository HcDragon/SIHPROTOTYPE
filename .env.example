# Copy to .env and replace the placeholder values. Never commit .env.

# development | test | production
APP_ENV=development

# PostgreSQL (docker-compose "db" service)
POSTGRES_USER=flowguard
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=flowguard
POSTGRES_PORT=5432

# Backend connection when running on the host. The backend container builds
# its own URL from the POSTGRES_* values and the "db" hostname.
DATABASE_URL=postgresql+psycopg://flowguard:change-me-db-password@localhost:5432/flowguard

# Disposable test database (docker-compose "db_test" service). Tests use only this.
TEST_POSTGRES_USER=flowguard_test
TEST_POSTGRES_PASSWORD=change-me-test-password
TEST_POSTGRES_DB=flowguard_test
TEST_POSTGRES_PORT=5433
TEST_DATABASE_URL=postgresql+psycopg://flowguard_test:change-me-test-password@localhost:5433/flowguard_test

# Token signing secret: at least 32 characters. The placeholder is rejected
# outside development and test. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Password given to every seeded demo user (fictional accounts only).
DEMO_PASSWORD=change-me-demo-password

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Run "alembic upgrade head" when the backend container starts.
RUN_MIGRATIONS_ON_START=true
